# Fotos y materiales subidos por los usuarios
uploads/fotos/*
!uploads/fotos/.gitkeep
uploads/materiales/*
!uploads/materiales/.gitkeep
uploads/comprobantes/*
!uploads/comprobantes/.gitkeep
uploads/libros/portadas/*
!uploads/libros/portadas/.gitkeep
uploads/libros_privados/*
!uploads/libros_privados/.gitkeep
!uploads/libros_privados/.htaccess

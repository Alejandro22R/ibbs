# Configuración local / credenciales de entorno
.env
.env.local

# Archivos de SO / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Servidor de WebSocket (ws-server/) — dependencias de Node, nunca al repo
ws-server/node_modules/
ws-server/npm-debug.log*

# IBBS — Variables de entorno locales del servidor.
#
# Copiar este archivo a ".env" (sin ".example") en la raíz del
# proyecto, al lado de login.php, y completar los valores reales ahí.
# ".env" NUNCA se sube a git (está en .gitignore) — es la forma más
# simple de configurar credenciales sin tocar ningún archivo del
# repositorio ni dejarlas en el historial de git.
#
# Todo lo de acá es opcional. Si no existe este archivo, o si una
# variable queda vacía, el sistema usa sus valores por defecto
# (base de datos local XAMPP/WAMP, correo por mail() de PHP).

# ── Base de datos ──────────────────────────────────────────
# IBBS_DB_HOST=localhost
# IBBS_DB_USER=root
# IBBS_DB_PASS=
# IBBS_DB_NAME=ibbs

# ── Correo saliente (recuperación de contraseña por correo) ─
# Ejemplo con Gmail + contraseña de aplicación (ver README,
# sección "Recuperación de contraseña por correo", para los pasos
# exactos de cómo generarla):
# IBBS_SMTP_HOST=smtp.gmail.com
# IBBS_SMTP_PORT=587
# IBBS_SMTP_SECURE=tls
# IBBS_SMTP_USER=tuinstituto@gmail.com
# IBBS_SMTP_PASS=abcdabcdabcdabcd
# IBBS_MAIL_FROM=tuinstituto@gmail.com
# IBBS_MAIL_FROM_NAME=IBBS - Instituto Biblico Bautista del Sur

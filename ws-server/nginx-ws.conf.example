# IBBS — snippet de nginx para exponer el WebSocket con TLS (wss://)
# delante del proceso Node (que solo escucha en 127.0.0.1:8081, nunca
# expuesto directo a Internet).
#
# Insertar este bloque "location" dentro del server{} HTTPS que ya
# tengas para tu dominio (o crear un subdominio dedicado, ej.
# ws.tudominio.com). Requiere certbot/Let's Encrypt ya configurado —
# no lo repite acá para no chocar con tu config existente.
#
# Ejemplo de uso completo:
#
#   server {
#       listen 443 ssl http2;
#       server_name ws.tudominio.com;
#
#       ssl_certificate     /etc/letsencrypt/live/ws.tudominio.com/fullchain.pem;
#       ssl_certificate_key /etc/letsencrypt/live/ws.tudominio.com/privkey.pem;
#
#       location /ws {
#           proxy_pass http://127.0.0.1:8081/ws;
#           proxy_http_version 1.1;
#           proxy_set_header Upgrade $http_upgrade;
#           proxy_set_header Connection "upgrade";
#           proxy_set_header Host $host;
#           proxy_set_header X-Real-IP $remote_addr;
#           proxy_read_timeout 3600s;   # las conexiones WS quedan abiertas mucho tiempo
#           proxy_send_timeout 3600s;
#       }
#
#       # /broadcast y /health NO se exponen acá a propósito — solo
#       # deben ser alcanzables desde localhost (donde corre PHP).
#       # Si Apache/PHP corre en OTRA máquina que el VPS de Node, hay
#       # que abrir el firewall solo a la IP de esa máquina, nunca a
#       # todo Internet, para /broadcast (lleva el secreto en un header,
#       # pero igual conviene no exponerlo).
#   }
#
# Con esto, IBBS_WS_URL del lado PHP queda:
#   IBBS_WS_URL=wss://ws.tudominio.com/ws

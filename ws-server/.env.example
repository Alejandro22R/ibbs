# IBBS — Configuración del servidor de WebSocket
# Copiar a ".env" en este mismo directorio (ws-server/.env) y completar.
# NUNCA subir el .env real a git — solo este .example.

# Puerto donde escucha Node (WebSocket + endpoint interno /broadcast).
# Detrás de nginx, este puerto solo debería ser accesible desde localhost.
WS_PORT=8081

# Debe ser EXACTAMENTE el mismo valor que IBBS_WS_SECRET en el entorno
# de PHP (ver config/ws_config.php) — con esto se firman/verifican los
# tokens de conexión y se autentica el endpoint interno /broadcast.
# Generalo una sola vez con: openssl rand -hex 32
WS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Opcional: si se define, solo se aceptan conexiones WebSocket cuyo
# header Origin coincida exactamente (ej. https://campus.tudominio.com).
# Dejar vacío para no filtrar por origen.
WS_ALLOWED_ORIGIN=
